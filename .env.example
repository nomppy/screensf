# Required. Free key from https://www.themoviedb.org/settings/api (v3 auth).
TMDB_API_KEY=

# Letterboxd username whose public watchlist to match against.
LETTERBOXD_USER=sunkht

# Films in TMDB's US "now playing" list with popularity at or above this are
# auto-excluded as blockbusters. Lower = stricter. Default 60.
BLOCKBUSTER_POPULARITY=60

# A film newer than two years with at least this many showtimes in the sync
# window is a first-run booking (several shows a day for weeks) and is
# auto-excluded. Repertory titles are never affected.
FIRST_RUN_SHOWTIMES=20

# Films older than two years (or 90+ days old and out of wide release) with
# TMDB popularity at or above this are held for review instead of being
# included on sight: studio re-releases, kids' matinees. Lower = stricter.
REPERTORY_POPULARITY=20

# Send a macOS desktop notification when sync finds new watchlist matches.
NOTIFY_MACOS=1

# How many weeks ahead to fetch and show. Default 4.
SYNC_WEEKS=4
