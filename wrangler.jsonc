// Cloudflare Workers config: serve the Astro build as static assets.
// Used by the Git integration's deploy step (`npx wrangler deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screensf",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
