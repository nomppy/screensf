---
import { runtime, time12, type Card } from '../lib/schedule';

interface Props {
  card: Card;
}
const { card } = Astro.props;
const { film } = card;
const art = film.backdrop ?? film.poster;
const meta = [film.year, film.genre, runtime(film.runtime)].filter(Boolean).join(', ');
const id = `${card.date}|${film.key}`;
const venueIds = card.showings.map((s) => s.venue.id);
// Everything the detail modal needs, serialised once per card.
const detail = {
  id,
  title: film.title,
  year: film.year ?? null,
  director: film.director ?? null,
  runtime: film.runtime ?? null,
  genre: film.genre ?? null,
  overview: film.overview ?? null,
  tmdbId: film.tmdbId ?? null,
  art: art ?? null,
  note: card.note ?? null,
  format: card.format ?? null,
  date: card.date,
  showings: card.showings.map((s) => ({
    venue: { id: s.venue.id, name: s.venue.name, url: s.venue.url },
    times: s.times,
    format: s.format ?? null,
    note: s.note ?? null,
  })),
};
---

<article class="card" data-venues={venueIds.join(',')} data-venue={venueIds[0]} data-detail={id} tabindex="0" role="button" aria-haspopup="dialog">
  <script type="application/json" set:html={JSON.stringify(detail)} />
  <div class:list={['art', { poster: !film.backdrop && film.poster }]}>
    {art ? <img src={art} alt={film.title} loading="lazy" /> : <div class="placeholder">No image</div>}
  </div>
  <div class="body">
    <div class="title">{film.title}</div>
    {card.note ? <div class="note">{card.note}</div> : null}
    {card.format ? <div class="tags"><span class="tag format">{card.format}</span></div> : null}
    {film.director ? <div class="meta">{film.director}</div> : null}
    {meta ? <div class="meta">{meta}</div> : null}
    <div class="showings">
      {card.showings.map((s) => (
        <div class="showing" data-venue={s.venue.id}>
          <div class="venue">
            {s.venue.url ? <a href={s.venue.url} target="_blank" rel="noopener">{s.venue.name}</a> : s.venue.name}
            {!card.format && s.format ? <span class="tag format">{s.format}</span> : null}
          </div>
          {!card.note && s.note ? <div class="note">{s.note}</div> : null}
          <div class="times">
            {s.times.map((t) =>
              t.url ? (
                <a href={t.url} target="_blank" rel="noopener">{time12(t.time)}</a>
              ) : (
                <a>{time12(t.time)}</a>
              ),
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</article>
