---
import '../styles/global.css';
import { SITE_NAME, SITE_TAGLINE } from '../lib/schedule';

interface Props {
  title?: string;
  current?: 'schedule' | 'about';
}
const { title, current = 'schedule' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={SITE_TAGLINE} />
    <meta name="theme-color" content="#1a1917" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 64 28" width="46" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <!-- towers -->
            <path d="M16 26V6M22 26V6M16 10h6M16 15h6M16 20h6" />
            <path d="M42 26V6M48 26V6M42 10h6M42 15h6M42 20h6" />
            <!-- main cable -->
            <path d="M1 20C6 14 12 8 19 6c6 2 8 12 13 12s7-10 13-12c7 2 13 8 18 14" />
            <!-- deck -->
            <path d="M1 22h62" class="deck" />
            <!-- hangers -->
            <path d="M8 22v-5M12 22v-10M26 22v-8M32 22v-4M38 22v-8M52 22v-10M56 22v-5" stroke-width="1" />
          </svg>
          Screen <span>SF</span>
        </a>
        <nav class="nav">
          <a href="/" aria-current={current === 'schedule' ? 'page' : undefined}>Schedule</a>
          <a href="/about" aria-current={current === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>
