---
import Layout from '../components/Layout.astro';
import ScreeningCard from '../components/ScreeningCard.astro';
import FilmModal from '../components/FilmModal.astro';
import { activeVenues, buildDays, headingFor } from '../lib/schedule';

const days = buildDays();
const venues = activeVenues();
const total = days.reduce((n, d) => n + d.cards.length, 0);

const REGION: Record<string, string> = {
  'San Francisco': 'San Francisco',
  Berkeley: 'East Bay',
  Oakland: 'East Bay',
  Albany: 'East Bay',
  'Palo Alto': 'South Bay',
  'San Rafael': 'North Bay',
};
const REGION_ORDER = ['San Francisco', 'East Bay', 'South Bay', 'North Bay'];
const regions = REGION_ORDER.map((name) => ({
  name,
  venues: venues.filter((v) => (REGION[v.city] ?? 'San Francisco') === name).map((v) => v.id),
})).filter((r) => r.venues.length);
---

<Layout>
  <div class="page-head">
    <h1>Upcoming Screenings</h1>
    {
      venues.length > 1 ? (
        <div class="filters" id="filters" role="group" aria-label="Filter by theatre">
          <div class="filter-row">
            <button class="chip" data-sel="all" aria-pressed="true">All theatres</button>
            {regions.length > 1
              ? regions.map((r) => (
                  <button class="chip" data-sel={`region:${r.name}`} data-venues={r.venues.join(',')} aria-pressed="false">
                    {r.name}
                  </button>
                ))
              : null}
          </div>
          <div class="filter-row">
            {venues.map((v) => (
              <button class="chip chip-venue" data-sel={v.id} aria-pressed="false">{v.shortName}</button>
            ))}
          </div>
        </div>
      ) : null
    }
    <p class="kb-hint" aria-hidden="true">
      <kbd>h</kbd><kbd>j</kbd><kbd>k</kbd><kbd>l</kbd> to move, <kbd>o</kbd> to open, <kbd>1</kbd>–<kbd>5</kbd> region, <kbd>?</kbd> for all keys
    </p>
  </div>


  {
    total === 0 ? (
      <div class="empty">
        <p>No upcoming screenings yet.</p>
        <p>Run <code>npm run sync</code> to pull listings, or <code>npm run add</code> to enter one by hand.</p>
      </div>
    ) : (
      days.map((day) => (
        <section class="day" data-date={day.date}>
          <h2 class="day-head">
            {headingFor(day.date)}
            <small>{day.cards.length} {day.cards.length === 1 ? 'screening' : 'screenings'}</small>
          </h2>
          <div class="grid">{day.cards.map((card) => <ScreeningCard card={card} />)}</div>
        </section>
      ))
    )
  }
  <FilmModal />

  <dialog id="kb-help" class="modal kb-help" aria-labelledby="kb-help-title">
    <button class="modal-close" data-kb-close aria-label="Close">×</button>
    <h2 id="kb-help-title">Keyboard</h2>
    <dl class="kb-list">
      <dt><kbd>h</kbd> <kbd>j</kbd> <kbd>k</kbd> <kbd>l</kbd></dt><dd>move left / down / up / right</dd>
      <dt><kbd>J</kbd> <kbd>K</kbd></dt><dd>next / previous day</dd>
      <dt><kbd>g g</kbd> <kbd>G</kbd></dt><dd>first / last film</dd>
      <dt><kbd>o</kbd> <kbd>Enter</kbd></dt><dd>open details</dd>
      <dt><kbd>t</kbd></dt><dd>tickets for the selected showtime</dd>
      <dt><kbd>c</kbd></dt><dd>add to Google Calendar (details open)</dd>
      <dt><kbd>l</kbd></dt><dd>Letterboxd page (details open)</dd>
      <dt><kbd>1</kbd> … <kbd>5</kbd></dt><dd>filter by region, <kbd>1</kbd> is all</dd>
      <dt><kbd>Esc</kbd></dt><dd>close</dd>
      <dt><kbd>?</kbd></dt><dd>this list</dd>
    </dl>
  </dialog>
</Layout>

<script>
  // Venue filter chips. Pure client-side; the page is fully static.
  // A selection is 'all', 'region:<name>' (chip carries data-venues) or a venue id.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#filters .chip'));
  const regionChips = chips.filter((c) => !c.classList.contains('chip-venue'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
  const days = Array.from(document.querySelectorAll<HTMLElement>('.day'));
  const key = 'screensf:filter';

  function allowed(sel: string): ((venue: string) => boolean) {
    if (sel === 'all') return () => true;
    const chip = chips.find((c) => c.dataset.sel === sel);
    if (chip?.dataset.venues) {
      const set = new Set(chip.dataset.venues.split(','));
      return (v) => set.has(v);
    }
    return (v) => v === sel;
  }

  function apply(sel: string) {
    const ok = allowed(sel);
    for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.sel === sel));
    for (const card of cards) card.hidden = !ok(card.dataset.venue ?? '');
    for (const day of days) {
      const visible = day.querySelectorAll('.card:not([hidden])').length;
      day.hidden = visible === 0;
      const small = day.querySelector('.day-head small');
      if (small) small.textContent = `${visible} ${visible === 1 ? 'screening' : 'screenings'}`;
    }
    try {
      localStorage.setItem(key, sel);
    } catch {}
  }

  for (const c of chips) c.addEventListener('click', () => apply(c.dataset.sel ?? 'all'));

  // Hide days that have already passed if the build is stale.
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles' }).format(new Date());
  for (const day of days) if ((day.dataset.date ?? '') < today) day.remove();

  let saved = 'all';
  try {
    saved = localStorage.getItem(key) ?? 'all';
  } catch {}
  if (chips.some((c) => c.dataset.sel === saved)) apply(saved);

  // ---- vim-style keys -------------------------------------------------------
  // h/j/k/l move by screen position, not DOM order, so "down" is the card
  // below in the grid and "right" is the card beside it.
  const help = document.getElementById('kb-help') as HTMLDialogElement | null;
  const film = document.getElementById('film-modal') as HTMLDialogElement | null;
  const visibleCards = () => Array.from(document.querySelectorAll<HTMLElement>('.day:not([hidden]) .card:not([hidden])'));
  const focused = () => document.activeElement instanceof HTMLElement ? document.activeElement.closest<HTMLElement>('.card') : null;

  function go(card: HTMLElement | undefined) {
    if (!card) return;
    card.focus({ preventScroll: true });
    card.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }

  type Dir = 'h' | 'j' | 'k' | 'l';
  function move(dir: Dir) {
    const list = visibleCards();
    if (!list.length) return;
    const cur = focused();
    if (!cur || !list.includes(cur)) {
      // Nothing focused: start at the first card that is on screen.
      go(list.find((c) => c.getBoundingClientRect().bottom > 0) ?? list[0]);
      return;
    }
    const r = cur.getBoundingClientRect();
    const cx = (r.left + r.right) / 2;
    const cy = (r.top + r.bottom) / 2;
    const EPS = 4;
    let best: { el: HTMLElement; primary: number; secondary: number } | undefined;
    for (const el of list) {
      if (el === cur) continue;
      const b = el.getBoundingClientRect();
      const bcx = (b.left + b.right) / 2;
      const bcy = (b.top + b.bottom) / 2;
      let primary: number;
      let secondary: number;
      switch (dir) {
        case 'j': if (b.top < r.bottom - EPS) continue; primary = b.top - r.bottom; secondary = Math.abs(bcx - cx); break;
        case 'k': if (b.bottom > r.top + EPS) continue; primary = r.top - b.bottom; secondary = Math.abs(bcx - cx); break;
        case 'l': if (b.left < r.right - EPS || Math.abs(bcy - cy) > r.height / 2) continue; primary = b.left - r.right; secondary = 0; break;
        case 'h': if (b.right > r.left + EPS || Math.abs(bcy - cy) > r.height / 2) continue; primary = r.left - b.right; secondary = 0; break;
      }
      if (!best || primary < best.primary - EPS || (Math.abs(primary - best.primary) <= EPS && secondary < best.secondary)) {
        best = { el, primary, secondary };
      }
    }
    if (best) { go(best.el); return; }
    // End of a row: h/l wrap to the previous/next card in reading order.
    if (dir === 'h' || dir === 'l') {
      const i = list.indexOf(cur);
      go(list[i + (dir === 'l' ? 1 : -1)]);
    }
  }
  function stepDay(delta: number) {
    const list = visibleCards();
    const cur = focused() ?? list[0];
    if (!cur) return;
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.day:not([hidden])'));
    const i = sections.indexOf(cur.closest<HTMLElement>('.day')!);
    const target = sections[i + delta] ?? (delta > 0 ? sections[sections.length - 1] : sections[0]);
    go(target.querySelector<HTMLElement>('.card:not([hidden])') ?? undefined);
  }
  function inModal(...sels: string[]) {
    if (!film?.open) return;
    for (const sel of sels) {
      const a = film.querySelector<HTMLAnchorElement>(sel);
      if (a) { a.click(); return; }
    }
  }
  function usedKeys() {
    document.querySelector('.kb-hint')?.classList.add('used');
  }

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, select, [contenteditable]')) return;

    if (e.key === '?') {
      e.preventDefault();
      if (!help) return;
      help.open ? help.close() : help.showModal();
      return;
    }
    if (help?.open) return; // native Esc closes it

    if (film?.open) {
      // Details open: act on the modal's own links; j/k step to the neighbouring film.
      if (e.key === 't') { e.preventDefault(); inModal('.modal-times a[aria-pressed="true"]', '.modal-times a'); return; }
      if (e.key === 'c') { e.preventDefault(); inModal('[data-gcal]'); return; }
      if (e.key === 'l') { e.preventDefault(); inModal('[data-letterboxd]'); return; }
      if (e.key === 'j' || e.key === 'k' || e.key === 'h') {
        e.preventDefault();
        film.close();
        const list = visibleCards();
        const cur = focused();
        const i = cur ? list.indexOf(cur) : -1;
        const next = list[i + (e.key === 'k' || e.key === 'h' ? -1 : 1)];
        if (next) { go(next); next.click(); }
      }
      return;
    }

    switch (e.key) {
      case 'h': case 'j': case 'k': case 'l': e.preventDefault(); usedKeys(); move(e.key); break;
      case 'J': e.preventDefault(); stepDay(1); break;
      case 'K': e.preventDefault(); stepDay(-1); break;
      case 'G': e.preventDefault(); go(visibleCards().at(-1)); break;
      case 'o': e.preventDefault(); focused()?.click(); break;
      case 't': {
        const a = focused()?.querySelector<HTMLAnchorElement>('.times a');
        if (a) { e.preventDefault(); a.click(); }
        break;
      }
      case 'Escape': focused()?.blur(); break;
      default: {
        if (/^[1-9]$/.test(e.key)) {
          const chip = regionChips[Number(e.key) - 1];
          if (chip) { e.preventDefault(); apply(chip.dataset.sel ?? 'all'); }
        }
      }
    }
  });
  // "gg": two g presses inside 600 ms.
  let lastG = 0;
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'g' || e.ctrlKey || e.metaKey || e.altKey) return;
    if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
    if (help?.open || film?.open) return;
    if (e.timeStamp - lastG < 600) { e.preventDefault(); go(visibleCards()[0]); lastG = 0; } else lastG = e.timeStamp;
  });

  help?.querySelector('[data-kb-close]')?.addEventListener('click', () => help.close());
  help?.addEventListener('click', (e) => { if (e.target === help) help.close(); });
</script>
