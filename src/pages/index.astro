---
import Layout from '../components/Layout.astro';
import ScreeningCard from '../components/ScreeningCard.astro';
import FilmModal from '../components/FilmModal.astro';
import { activeVenues, buildDays, dateRange, headingFor, upcomingFestivals, venueFor } from '../lib/schedule';

const days = buildDays();
const venues = activeVenues();
const total = days.reduce((n, d) => n + d.cards.length, 0);
const festivals = upcomingFestivals();
---

<Layout>
  <div class="page-head">
    <h1>Upcoming Screenings</h1>
    {
      venues.length > 1 ? (
        <div class="filters" id="filters" role="group" aria-label="Filter by venue">
          <button class="chip" data-venue="all" aria-pressed="true">All venues</button>
          {venues.map((v) => (
            <button class="chip" data-venue={v.id} aria-pressed="false">{v.shortName}</button>
          ))}
        </div>
      ) : null
    }
  </div>

  {
    festivals.length ? (
      <section class="festivals" aria-label="Festivals">
        <h2 class="festivals-head">Festivals &amp; series</h2>
        <div class="festival-row">
          {festivals.map((f) => {
            const v = venueFor(f.venueId);
            return (
              <a class="festival" href={f.url} target="_blank" rel="noopener" data-venue={f.venueId}>
                <div class="festival-dates">{dateRange(f.startDate, f.endDate)}</div>
                <div class="festival-name">{f.name}</div>
                <div class="festival-meta">
                  {v.shortName} · {f.showtimes} {f.showtimes === 1 ? 'screening' : 'screenings'}
                </div>
                {f.sample.length ? <div class="festival-sample">{f.sample.join(' · ')}</div> : null}
              </a>
            );
          })}
        </div>
      </section>
    ) : null
  }

  {
    total === 0 && festivals.length === 0 ? (
      <div class="empty">
        <p>No upcoming screenings yet.</p>
        <p>Run <code>npm run sync</code> to pull listings, or <code>npm run add</code> to enter one by hand.</p>
      </div>
    ) : (
      days.map((day) => (
        <section class="day" data-date={day.date}>
          <h2 class="day-head">
            {headingFor(day.date)}
            <small>{day.cards.length} {day.cards.length === 1 ? 'screening' : 'screenings'}</small>
          </h2>
          <div class="grid">{day.cards.map((card) => <ScreeningCard card={card} />)}</div>
        </section>
      ))
    )
  }
  <FilmModal />
</Layout>

<script>
  // Venue filter chips. Pure client-side; the page is fully static.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#filters .chip'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card, .festival'));
  const days = Array.from(document.querySelectorAll<HTMLElement>('.day'));
  const key = 'screenbay:venue';

  function apply(venue: string) {
    for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.venue === venue));
    for (const card of cards) card.hidden = venue !== 'all' && card.dataset.venue !== venue;
    for (const day of days) {
      const visible = day.querySelectorAll('.card:not([hidden])').length;
      day.hidden = visible === 0;
      const small = day.querySelector('.day-head small');
      if (small) small.textContent = `${visible} ${visible === 1 ? 'screening' : 'screenings'}`;
    }
    try {
      localStorage.setItem(key, venue);
    } catch {}
  }

  for (const c of chips) c.addEventListener('click', () => apply(c.dataset.venue ?? 'all'));

  // Hide days that have already passed if the build is stale.
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles' }).format(new Date());
  for (const day of days) if ((day.dataset.date ?? '') < today) day.remove();

  let saved = 'all';
  try {
    saved = localStorage.getItem(key) ?? 'all';
  } catch {}
  if (chips.some((c) => c.dataset.venue === saved)) apply(saved);
</script>
