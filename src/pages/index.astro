---
import Layout from '../components/Layout.astro';
import ScreeningCard from '../components/ScreeningCard.astro';
import FilmModal from '../components/FilmModal.astro';
import { activeVenues, buildDays, dateRange, headingFor, upcomingFestivals, venueFor } from '../lib/schedule';

const days = buildDays();
const venues = activeVenues();
const total = days.reduce((n, d) => n + d.cards.length, 0);
const festivals = upcomingFestivals();
---

<Layout>
  <div class="page-head">
    <h1>Upcoming Screenings</h1>
    {
      venues.length > 1 ? (
        <div class="filters" id="filters" role="group" aria-label="Filter by theatre">
          <button class="chip" data-venue="all" aria-pressed="true">All theatres</button>
          {venues.map((v) => (
            <button class="chip" data-venue={v.id} aria-pressed="false">{v.shortName}</button>
          ))}
        </div>
      ) : null
    }
  </div>

  {
    festivals.length ? (
      <section class="festivals" aria-label="Festivals">
        <h2 class="festivals-head">Festivals &amp; series</h2>
        <div class="festival-row">
          {festivals.map((f) => {
            const v = venueFor(f.venueId);
            return (
              <a class="festival" href={f.url} target="_blank" rel="noopener" data-venue={f.venueId}>
                <div class="festival-dates">{dateRange(f.startDate, f.endDate)}</div>
                <div class="festival-name">{f.name}</div>
                <div class="festival-meta">
                  {v.shortName} · {f.showtimes} {f.showtimes === 1 ? 'screening' : 'screenings'}
                </div>
                {f.sample.length ? <div class="festival-sample">{f.sample.join(' · ')}</div> : null}
              </a>
            );
          })}
        </div>
      </section>
    ) : null
  }

  {
    total === 0 && festivals.length === 0 ? (
      <div class="empty">
        <p>No upcoming screenings yet.</p>
        <p>Run <code>npm run sync</code> to pull listings, or <code>npm run add</code> to enter one by hand.</p>
      </div>
    ) : (
      days.map((day) => (
        <section class="day" data-date={day.date}>
          <h2 class="day-head">
            {headingFor(day.date)}
            <small>{day.cards.length} {day.cards.length === 1 ? 'screening' : 'screenings'}</small>
          </h2>
          <div class="grid">{day.cards.map((card) => <ScreeningCard card={card} />)}</div>
        </section>
      ))
    )
  }
  <FilmModal />

  <dialog id="kb-help" class="modal kb-help" aria-labelledby="kb-help-title">
    <button class="modal-close" data-kb-close aria-label="Close">×</button>
    <h2 id="kb-help-title">Keyboard</h2>
    <dl class="kb-list">
      <dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>next / previous film</dd>
      <dt><kbd>J</kbd> <kbd>K</kbd></dt><dd>next / previous day</dd>
      <dt><kbd>g g</kbd> <kbd>G</kbd></dt><dd>first / last film</dd>
      <dt><kbd>o</kbd> <kbd>Enter</kbd></dt><dd>open details</dd>
      <dt><kbd>t</kbd></dt><dd>tickets for the selected showtime</dd>
      <dt><kbd>c</kbd></dt><dd>add to Google Calendar (details open)</dd>
      <dt><kbd>l</kbd></dt><dd>Letterboxd page (details open)</dd>
      <dt><kbd>1</kbd> … <kbd>9</kbd></dt><dd>filter by theatre, <kbd>1</kbd> is all</dd>
      <dt><kbd>Esc</kbd></dt><dd>close</dd>
      <dt><kbd>?</kbd></dt><dd>this list</dd>
    </dl>
  </dialog>
</Layout>

<script>
  // Venue filter chips. Pure client-side; the page is fully static.
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#filters .chip'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card, .festival'));
  const days = Array.from(document.querySelectorAll<HTMLElement>('.day'));
  const key = 'screensf:venue';

  function apply(venue: string) {
    for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.venue === venue));
    for (const card of cards) card.hidden = venue !== 'all' && card.dataset.venue !== venue;
    for (const day of days) {
      const visible = day.querySelectorAll('.card:not([hidden])').length;
      day.hidden = visible === 0;
      const small = day.querySelector('.day-head small');
      if (small) small.textContent = `${visible} ${visible === 1 ? 'screening' : 'screenings'}`;
    }
    try {
      localStorage.setItem(key, venue);
    } catch {}
  }

  for (const c of chips) c.addEventListener('click', () => apply(c.dataset.venue ?? 'all'));

  // Hide days that have already passed if the build is stale.
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles' }).format(new Date());
  for (const day of days) if ((day.dataset.date ?? '') < today) day.remove();

  let saved = 'all';
  try {
    saved = localStorage.getItem(key) ?? 'all';
  } catch {}
  if (chips.some((c) => c.dataset.venue === saved)) apply(saved);

  // ---- vim-style keys -------------------------------------------------------
  const help = document.getElementById('kb-help') as HTMLDialogElement | null;
  const film = document.getElementById('film-modal') as HTMLDialogElement | null;
  const visibleCards = () => Array.from(document.querySelectorAll<HTMLElement>('.day:not([hidden]) .card:not([hidden])'));
  const focused = () => document.activeElement instanceof HTMLElement ? document.activeElement.closest<HTMLElement>('.card') : null;

  function go(card: HTMLElement | undefined) {
    if (!card) return;
    card.focus({ preventScroll: true });
    card.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }
  function step(delta: number) {
    const list = visibleCards();
    if (!list.length) return;
    const cur = focused();
    const i = cur ? list.indexOf(cur) : -1;
    go(list[i < 0 ? (delta > 0 ? 0 : list.length - 1) : Math.min(list.length - 1, Math.max(0, i + delta))]);
  }
  function stepDay(delta: number) {
    const list = visibleCards();
    const cur = focused() ?? list[0];
    if (!cur) return;
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.day:not([hidden])'));
    const i = sections.indexOf(cur.closest<HTMLElement>('.day')!);
    const target = sections[i + delta] ?? (delta > 0 ? sections[sections.length - 1] : sections[0]);
    go(target.querySelector<HTMLElement>('.card:not([hidden])') ?? undefined);
  }
  function inModal(...sels: string[]) {
    if (!film?.open) return;
    for (const sel of sels) {
      const a = film.querySelector<HTMLAnchorElement>(sel);
      if (a) { a.click(); return; }
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, select, [contenteditable]')) return;

    if (e.key === '?') {
      e.preventDefault();
      if (!help) return;
      help.open ? help.close() : help.showModal();
      return;
    }
    if (help?.open) return; // native Esc closes it

    if (film?.open) {
      // Details open: act on the modal's own links; j/k still move underneath.
      if (e.key === 't') { e.preventDefault(); inModal('.modal-times a[aria-pressed="true"]', '.modal-times a'); return; }
      if (e.key === 'c') { e.preventDefault(); inModal('[data-gcal]'); return; }
      if (e.key === 'l') { e.preventDefault(); inModal('[data-letterboxd]'); return; }
      if (e.key === 'j' || e.key === 'k') {
        e.preventDefault();
        film.close();
        step(e.key === 'j' ? 1 : -1);
        focused()?.click();
      }
      return;
    }

    switch (e.key) {
      case 'j': e.preventDefault(); step(1); break;
      case 'k': e.preventDefault(); step(-1); break;
      case 'J': e.preventDefault(); stepDay(1); break;
      case 'K': e.preventDefault(); stepDay(-1); break;
      case 'G': e.preventDefault(); go(visibleCards().at(-1)); break;
      case 'o': e.preventDefault(); focused()?.click(); break;
      case 't': {
        const a = focused()?.querySelector<HTMLAnchorElement>('.times a');
        if (a) { e.preventDefault(); a.click(); }
        break;
      }
      case 'Escape': focused()?.blur(); break;
      default: {
        if (/^[1-9]$/.test(e.key)) {
          const chip = chips[Number(e.key) - 1];
          if (chip) { e.preventDefault(); apply(chip.dataset.venue ?? 'all'); }
        }
      }
    }
  });
  // "gg": two g presses inside 600 ms.
  let lastG = 0;
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'g' || e.ctrlKey || e.metaKey || e.altKey) return;
    if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
    if (help?.open || film?.open) return;
    if (e.timeStamp - lastG < 600) { e.preventDefault(); go(visibleCards()[0]); lastG = 0; } else lastG = e.timeStamp;
  });

  help?.querySelector('[data-kb-close]')?.addEventListener('click', () => help.close());
  help?.addEventListener('click', (e) => { if (e.target === help) help.close(); });
</script>
